# ---- required ----
# Solami API key (https://solami.dev/signup) — needs DataApi permission for Blur streams
SOLAMI_API_KEY=

# ---- backend ----
# Address the API + WebSocket server binds to
BIND=127.0.0.1:8080
# Blur REST base (override only if Solami moves it)
BLUR_REST_BASE=https://api.solami.dev/data
# Comma-separated Blur event types to stream
BLUR_EVENT_TYPES=swap,token_create,pool_create,meme,graduation,surge,metadata

# ---- smart money ----
# Comma-separated seed wallet addresses treated as smart money
SMART_MONEY_SEEDS=
# Periodically merge Blur's trader leaderboard into the smart-money set
SMART_DISCOVERY=true
# Subscribe to smart-money wallets' on-chain transactions via Yellowstone gRPC
# (catches buys on DEXes Blur doesn't decode). Uses one Pro gRPC stream slot.
GRPC_WALLET_TRACK=true

# ---- signal engine ----
# A tracked wallet's buy must be at least this large (USD) to count
MIN_SMART_BUY_USD=500
# Drop signals whose token has less cumulative buy volume than this (USD);
# also applied to a surge's window volume. Filtered signals are counted in
# metrics as signals_filtered_total.
MIN_SIGNAL_VOLUME_USD=5000
# gRPC wallet-track path: a smart-money buy must spend at least this much SOL
# (that path has no USD valuation at detection time)
MIN_SMART_BUY_SOL=0.5
# One signal per token per cooldown window (seconds)
SIGNAL_COOLDOWN_SECS=900
# Surge events with at least this volume multiple also trigger signals
SURGE_MIN_MULTIPLE=4
# Backfill signal PnL (1h/24h win rates) via Blur REST token prices,
# exposed at /api/performance. Costs up to ~20 REST calls per minute.
PNL_TRACK=true

# ---- trader ----
# false = dry-run (logs the trade it would take). true requires SOLAMI_TRADER_KEYPAIR.
LIVE_TRADING=false
# Position size per signal, in SOL
TRADE_SOL_PER_SIGNAL=0.02
# Daily spend cap, in SOL
MAX_DAILY_SOL=0.2
# Base58 keypair of the trading wallet (only needed for live mode / Beam health check)
SOLAMI_TRADER_KEYPAIR=
# On startup, land a 1000-lamport self-transfer via Beam and record the latency
BEAM_HEALTH_CHECK=false
# Slippage tolerance for buys, in basis points (1500 = 15%)
SLIPPAGE_BPS=1500
# Compute-unit price for live transactions, in microlamports
PRIORITY_FEE_MICROLAMPORTS=50000
# In dry-run mode, quote pump.fun / PumpSwap buys from on-chain state (read-only)
DRY_RUN_QUOTE=true

# ---- logging ----
RUST_LOG=info,shadow=debug
